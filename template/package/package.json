{
  "name": "{{name}}",
  "version": "0.0.0",
  "description": "{{description}}",
  "keywords": [],
  "homepage": "https://github.com/{{owner}}/{{repo}}#readme",
  "bugs": {
    "url": "https://github.com/{{owner}}/{{repo}}/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{owner}}/{{repo}}.git"
  },
  "license": "MIT",
  "author": {
    "name": "{{owner}}",
    "url": "https://github.com/{{owner}}"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "/*.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsup && tsc -p tsconfig.build.json && node scripts/emit-dts-shims.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "typedoc",
    "docs:api:report": "typedoc --options typedoc.markdown.json",
    "contract": "internal-package-contract",
    "version": "changeset version && npm run build",
    "release": "changeset publish",
    "benchmark": "node node_modules/internal-package-contract/scripts/benchmark/run-suite.mjs benchmarks/suite.mjs",
    "benchmark:check": "node node_modules/internal-package-contract/scripts/benchmark/run-suite.mjs benchmarks/suite.mjs --check",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:coverage",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "10.1.8",
    "internal-package-contract": "github:MaverickCER/internal-package-contract#{{ipcRef}}",
    "prettier": "3.9.6",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
