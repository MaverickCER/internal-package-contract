{
  // Type-checks this package's own authored TypeScript files (the contract
  // definition, its checks, and its own dogfooded repo-contract config).
  // `eslint.config.mjs`/`prettier.config.mjs` are deliberately plain
  // JavaScript, not TypeScript -- see either file's own doc comment for why
  // -- so they aren't included here; `@type` JSDoc comments there provide
  // editor support instead. Not part of the published surface -- it is
  // excluded from `files` in package.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "contract.ts",
    "repo-contract.config.ts",
    "vitest.config.ts",
    "checks/**/*.ts",
    "test/**/*.ts"
  ]
}
