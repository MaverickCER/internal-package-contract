#!/bin/sh
# internal-package-contract managed hook. A commit runs the contract under `--scope affected`: every
# check the change can reach, Coverage, Crap and Mutation included, so what CI will run has already
# passed before the change reaches history; where the analysis cannot be sure, everything runs. What CI
# adds beyond it (CodeRabbit, CodeQL) is left to those services. See pre-push for how the command is
# resolved. A push runs the whole contract minus the slow analyses.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
IPC_HOOK_FULL=1 exec "$DIR/pre-push"
