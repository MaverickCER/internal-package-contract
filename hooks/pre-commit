#!/bin/sh
# internal-package-contract managed hook. A commit runs the contract under `--scope affected`: every check
# the change can reach, Coverage, Crap and Mutation included. So a change reaches history already passing
# what CI will run. Where the analysis cannot be sure, everything runs. CodeRabbit and CodeQL stay with
# their services. pre-push finds the command to run; IPC_HOOK_FULL=1 makes it use the affected scope.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
IPC_HOOK_FULL=1 exec "$DIR/pre-push"
