#!/bin/sh
# internal-package-contract managed hook. A push runs every check except the slow analyses (Coverage,
# Crap, Mutation), which CI runs. Only the skip list is named, so a check added to the contract later runs
# here by default. The hook is a convenience; CI runs the same contract and is the gate. With
# IPC_HOOK_FULL=1, which pre-commit sets, it runs `--scope affected` instead, slow analyses included.
#
# The same hooks/ directory serves two repositories. `init` installs it in a consumer, which runs
# bin/contract.mjs against contract.ts. This repository has no build and no src/, so it runs its own
# self-contract: scripts/run-contract.mjs against repo-contract.config.ts.
#
# This repository is recognized by repo-contract.config.ts next to hooks/, with hooks/ physically inside the
# repository being pushed. The file is not in package.json `files`, so a packed install lacks it. A `file:`
# dependency is a symlink to this checkout, though, and the file is reachable through it. Resolving $DIR
# with `cd -P` and requiring it under the physical toplevel rules that case out.
#
# Git exports the repository's own location (GIT_INDEX_FILE, GIT_DIR, ...) to a hook. The contract's tests
# build throwaway repositories with `git`, and those commands would act on this repository's index instead
# of their own. Nothing the contract does wants them, so they are dropped before it runs.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
SKIP="--skip Coverage,Crap,Mutation"
if [ "${IPC_HOOK_FULL:-}" = "1" ]; then
  # Where the analysis cannot be sure what a change affects, it says so and everything runs.
  SKIP="--scope affected"
fi
DIR=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)
TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$TOPLEVEL" ]; then
  TOPLEVEL=$(CDPATH= cd -P -- "$TOPLEVEL" && pwd)
fi
case "$DIR" in
  "$TOPLEVEL"/*) inside_toplevel=1 ;;
  *) inside_toplevel=0 ;;
esac
if [ "$inside_toplevel" = "1" ] && [ -f "$DIR/../repo-contract.config.ts" ]; then
  # Through `npm run`, because the self-contract spawns plain command names (`eslint`, `vitest`, ...) that
  # resolve only on the PATH npm builds. A bare `node scripts/run-contract.mjs` fails every check with ENOENT.
  # $SKIP is split on purpose into the flag and its value.
  # shellcheck disable=SC2086
  exec npm --prefix "$DIR/.." run contract -- $SKIP
else
  # shellcheck disable=SC2086
  exec node "$DIR/../bin/contract.mjs" $SKIP
fi
