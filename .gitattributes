# Normalize line endings -- the repo stores LF, checkout is native.
* text=auto eol=lf

# Explicitly binary
*.png binary
*.jpg binary
*.gif binary
*.woff binary
*.woff2 binary
*.tgz binary

# Lockfiles: keep diffs collapsed in review, still merge textually
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff

# Generated -- collapse in review
CHANGELOG.md -diff
schemas/*.json linguist-generated=true

# Generated by the contract and checked against a fresh regeneration, never written by hand: collapsed in review so a
# change's own lines stay visible. The exception records are deliberately not here: a reviewer should read those.
/.repo-contract/api-contract/**/baseline.*  linguist-generated=true
/.repo-contract/surface-contract/baseline.json  linguist-generated=true
/docs/api-report/**  linguist-generated=true
/docs/ENVIRONMENT.md  linguist-generated=true
/docs/sbom*.json  linguist-generated=true
/benchmarks/**/results.json  linguist-generated=true
/benchmarks/**/BENCHMARKS.md  linguist-generated=true
