{
  "name": "internal-package-contract",
  "version": "0.10.0",
  "private": true,
  "description": "The engineering standard every publishable MaverickCER package must continuously satisfy, expressed once as a repo-contract contract. Not published to npm; consumed as a git devDependency pinned to a release tag.",
  "license": "MIT",
  "homepage": "https://github.com/MaverickCER/internal-package-contract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaverickCER/internal-package-contract.git"
  },
  "bugs": {
    "url": "https://github.com/MaverickCER/internal-package-contract/issues"
  },
  "author": {
    "name": "MaverickCER",
    "url": "https://github.com/MaverickCER"
  },
  "keywords": [
    "repo-contract",
    "monorepo",
    "governance",
    "ci",
    "lint",
    "internal"
  ],
  "type": "module",
  "bin": {
    "internal-package-contract": "./bin/contract.mjs"
  },
  "exports": {
    "./eslint": "./eslint.config.mjs",
    "./prettier": "./prettier.config.mjs",
    "./tsconfig": "./tsconfig.json",
    "./config/dependency-cruiser": "./config/dependency-cruiser.cjs",
    "./config/knip": "./config/knip.json",
    "./config/stryker": "./config/stryker.config.mjs",
    "./config/commitlint": "./config/commitlint.config.mjs",
    "./config/secretlint": "./config/secretlint.config.json",
    "./config/markdownlint": "./config/markdownlint.jsonc",
    "./config/typedoc": "./config/typedoc.json",
    "./config/typedoc-markdown": "./config/typedoc-markdown.json",
    "./config/typedoc-a11y-search-label": "./config/typedoc-a11y-search-label.mjs",
    "./checks/standard": "./checks/standard.ts",
    "./checks/*": "./checks/*.ts",
    "./package.json": "./package.json",
    "./benchmark": "./scripts/benchmark/kit/index.mjs"
  },
  "files": [
    "bin",
    "checks",
    "config",
    "hooks",
    "scripts",
    "template",
    "contract.ts",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.self.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contract": "node scripts/run-contract.mjs",
    "version": "changeset version"
  },
  "dependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@danibram/crap4ts": "^0.6.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.13",
    "@microsoft/api-extractor-model": "^7.33.12",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@socketsecurity/cli": "^1.1.169",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.19.1",
    "cross-spawn": "^7.0.6",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "github-actionlint": "^1.7.12",
    "github-slugger": "^2.0.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.3",
    "licensee": "^12.0.2",
    "linkinator": "^8.0.4",
    "markdownlint-cli2": "^0.23.3",
    "pa11y": "^10.0.0",
    "prettier": "3.9.9",
    "publint": "^0.3.24",
    "puppeteer-core": "^25.9.0",
    "repo-contract": "~0.10.0",
    "secretlint": "^13.0.7",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "tar": "^7.5.22",
    "qs": "^6.16.0",
    "pa11y": {
      "puppeteer": "npm:puppeteer-core@^25.9.0"
    },
    "adm-zip": "0.6.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
