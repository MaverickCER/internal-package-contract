{
  "name": "internal-package-contract",
  "version": "1.0.0",
  "private": true,
  "description": "The engineering standard every publishable @maverickcer/* package must continuously satisfy, expressed once as a repo-contract contract. Not published to npm; consumed as a devDependency.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "internal-package-contract": "./bin/contract.mjs"
  },
  "exports": {
    ".": "./contract.ts",
    "./contract": "./contract.ts",
    "./eslint": "./eslint.config.mjs",
    "./prettier": "./prettier.config.mjs",
    "./tsconfig": "./tsconfig.json",
    "./config/dependency-cruiser": "./config/dependency-cruiser.cjs",
    "./config/knip": "./config/knip.json",
    "./config/stryker": "./config/stryker.config.mjs",
    "./config/commitlint": "./config/commitlint.config.mjs",
    "./config/secretlint": "./config/secretlint.config.json",
    "./config/markdownlint": "./config/markdownlint.jsonc",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "checks",
    "config",
    "hooks",
    "scripts",
    "template",
    "contract.ts",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.self.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contract": "node scripts/run-contract.mjs"
  },
  "dependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@danibram/crap4ts": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.0",
    "@socketsecurity/cli": "^1.1.169",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-spawn": "^7.0.6",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "github-actionlint": "^1.7.12",
    "github-slugger": "^2.0.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.3",
    "licensee": "^11.1.1",
    "linkinator": "^8.0.4",
    "markdownlint-cli2": "^0.23.3",
    "pa11y": "^10.0.0",
    "prettier": "3.9.6",
    "publint": "^0.3.24",
    "puppeteer-core": "^25.9.0",
    "repo-contract": "^0.7.0",
    "secretlint": "^9.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tar": "^7.5.22",
    "qs": "^6.16.0",
    "pa11y": {
      "puppeteer": "npm:puppeteer-core@^25.9.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
